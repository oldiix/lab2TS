# Pre-commit hook: перед кожним комітом прогоняються лінтер і юніт-тести.
# Якщо будь-яка перевірка завершується ненульовим кодом — коміт блокується.

echo "▶ ESLint…"
npm run lint || {
  echo "✖ ESLint знайшов помилки — коміт скасовано."
  exit 1
}

echo "▶ Mocha…"
npm test || {
  echo "✖ Тести не пройшли — коміт скасовано."
  exit 1
}

echo "✔ Перевірки пройдено."
