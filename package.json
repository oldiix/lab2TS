{
  "name": "lab-app",
  "version": "1.0.0",
  "description": "Клієнтський застосунок управління бібліотекою (TypeScript + Webpack + Bootstrap)",
  "private": true,
  "scripts": {
    "start": "vite --port 9000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"vite.config.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"vite.config.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,scss}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,scss}\" \"tests/**/*.ts\"",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.test.json mocha",
    "deploy": "npm run build && gh-pages -d dist",
    "prepare": "husky",
    "preview": "vite preview --port 9000"
  },
  "keywords": [
    "typescript",
    "webpack",
    "bootstrap",
    "library"
  ],
  "author": "Mykhailo Buhera",
  "license": "MIT",
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "gh-pages": "^6.1.1",
    "husky": "^9.1.4",
    "mocha": "^10.7.0",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
